{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>tyutyutyu/github-manager//renovate/default"],
  "packageRules": [
    {
      "description": "Runs with the fleet tokens in the enforce workflow: merge by hand",

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>tyutyutyu/github-manager//renovate/default"],
  "github-actions": {
    "managerFilePatterns": [
      "/(^|/)(workflow-templates|\\.(?:github|gitea|forgejo)/(?:workflows|actions))/.+\\.ya?ml$/",
      "/(^|/)action\\.ya?ml$/",
      "/^templates/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "description": "Tool versions pinned in the synced workflow templates",
      "customType": "regex",
      "managerFilePatterns": ["/^templates/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*\\w+: (?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Runs with the fleet tokens in the enforce workflow: merge by hand",
      "matchManagers": ["github-actions"],
      "automerge": false
    },
    {
      "description": "Runs with the fleet tokens in the enforce workflow: merge by hand",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["project.dependencies", "build-system.requires"],
      "automerge": false
    }
  ]
}
